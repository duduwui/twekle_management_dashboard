[Unit]
Description=Twekl Dashboard 24/7 Traffic Simulator & Live Performance Monitor
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/twekl-dashboard/scripts/load-simulation
ExecStart=/usr/bin/python3 /opt/twekl-dashboard/scripts/load-simulation/traffic_simulator.py --host http://localhost:8080 --rate 35 --port 9090 --user twekl_super_admin --password Super@2026
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
